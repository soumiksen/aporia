{
  "components": {
    "schemas": {
      "AttemptRequest": {
        "additionalProperties": false,
        "description": "A submission outcome. No code, ever (extra fields are rejected).",
        "properties": {
          "slug": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Slug",
            "type": "string"
          },
          "verdict": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "verdict"
        ],
        "title": "AttemptRequest",
        "type": "object"
      },
      "EventBatch": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventBatch",
        "type": "object"
      },
      "EventIn": {
        "additionalProperties": false,
        "description": "One telemetry event. Strict: unknown fields are rejected, so code or problem text can never\narrive through a stray field.",
        "properties": {
          "level": {
            "anyOf": [
              {
                "maximum": 4.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "rating": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "consecutive_failures",
                  "repeated_failure",
                  "inactivity",
                  "low_progress"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "slug": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "ts": {
            "description": "epoch milliseconds",
            "title": "Ts",
            "type": "integer"
          },
          "type": {
            "enum": [
              "stuck_prompt_shown",
              "stuck_prompt_accepted",
              "stuck_prompt_dismissed",
              "hint_requested",
              "hint_rated",
              "stuck_label"
            ],
            "title": "Type",
            "type": "string"
          },
          "was_stuck": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Was Stuck"
          }
        },
        "required": [
          "type",
          "ts"
        ],
        "title": "EventIn",
        "type": "object"
      },
      "EventsAccepted": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          }
        },
        "required": [
          "accepted"
        ],
        "title": "EventsAccepted",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HintRequest": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "failed_attempts": {
            "default": 0,
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Failed Attempts",
            "type": "integer"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "last_verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Verdict"
          },
          "level": {
            "default": 1,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Level",
            "type": "integer"
          },
          "problem": {
            "$ref": "#/components/schemas/ProblemContext"
          },
          "student_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Message"
          }
        },
        "required": [
          "problem",
          "code",
          "language"
        ],
        "title": "HintRequest",
        "type": "object"
      },
      "ProblemContext": {
        "properties": {
          "content_text": {
            "title": "Content Text",
            "type": "string"
          },
          "difficulty": {
            "title": "Difficulty",
            "type": "string"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "difficulty",
          "tags",
          "content_text"
        ],
        "title": "ProblemContext",
        "type": "object"
      },
      "RatingRequest": {
        "properties": {
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          }
        },
        "required": [
          "rating"
        ],
        "title": "RatingRequest",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "postgres": {
            "title": "Postgres",
            "type": "string"
          },
          "redis": {
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "postgres",
          "redis"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Aporia API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz"
      }
    },
    "/v1/attempts": {
      "post": {
        "description": "Updates the learner model for the problem's concepts. Storage errors never fail the call.",
        "operationId": "post_attempt_v1_attempts_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-aporia-device",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Device"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Attempt"
      }
    },
    "/v1/events": {
      "post": {
        "description": "Stores a batch of allowlisted telemetry events (the extension only sends after opt-in).",
        "operationId": "post_events_v1_events_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-aporia-device",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Device"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Events"
      }
    },
    "/v1/hint": {
      "post": {
        "operationId": "post_hint_v1_hint_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-aporia-disable-guard",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Disable-Guard"
            }
          },
          {
            "in": "header",
            "name": "x-aporia-disable-rag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Disable-Rag"
            }
          },
          {
            "in": "header",
            "name": "x-aporia-disable-memory",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Disable-Memory"
            }
          },
          {
            "in": "header",
            "name": "x-aporia-device",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aporia-Device"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HintRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Hint"
      }
    },
    "/v1/hint/{hint_id}/rating": {
      "post": {
        "operationId": "post_rating_v1_hint__hint_id__rating_post",
        "parameters": [
          {
            "in": "path",
            "name": "hint_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Hint Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-aporia-device",
