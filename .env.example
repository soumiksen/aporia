# Copy to .env (never commit .env).
DATABASE_URL=postgresql+asyncpg://aporia:aporia@localhost:5432/aporia
REDIS_URL=redis://localhost:6379/0
JUDGE0_URL=http://localhost:2358
APORIA_ENV=dev

# You must fill these with provider model strings (for example a LiteLLM model id).
APORIA_MODEL_FAST=
APORIA_MODEL_STRONG=
APORIA_MODEL_JUDGE=
# 1 = use a deterministic mock instead of calling an LLM
APORIA_LLM_MOCK=1

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional: change host ports if 5432/6379 are taken (then update DATABASE_URL/REDIS_URL to match).
# APORIA_POSTGRES_PORT=5433
# APORIA_REDIS_PORT=6380

# 1 = also send prompts (including student code) to Langfuse traces. Keep 0 by default.
APORIA_TRACE_CODE=0

# Error tracking (off unless set). Request bodies and fields named code, content_text and
# student_message are scrubbed before anything is sent.
SENTRY_DSN=
# Extension build-time equivalent (set when building): VITE_SENTRY_DSN=

# Optional: forward stored usage events to PostHog (off unless set).
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# RAG (Stage 4). Provider embedding model string; vectors shorter than 1536 are zero-padded.
APORIA_EMBEDDING_MODEL=
# Set to 1 to rerank retrieved notes with BAAI/bge-reranker-v2-m3 (uv sync --group rerank).
APORIA_RERANK=0
# Ingest only notes marked reviewed: true.
APORIA_REQUIRE_REVIEWED_NOTES=0
