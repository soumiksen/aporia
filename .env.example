# Copy to .env (never commit .env).
DATABASE_URL=postgresql+asyncpg://aporia:aporia@localhost:5432/aporia
REDIS_URL=redis://localhost:6379/0
JUDGE0_URL=http://localhost:2358
APORIA_ENV=dev

# You must fill these with provider model strings (for example a LiteLLM model id).
APORIA_MODEL_FAST=
APORIA_MODEL_STRONG=
APORIA_MODEL_JUDGE=
# 1 = use a deterministic mock instead of calling an LLM
APORIA_LLM_MOCK=1

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional: change host ports if 5432/6379 are taken (then update DATABASE_URL/REDIS_URL to match).
# APORIA_POSTGRES_PORT=5433
# APORIA_REDIS_PORT=6380
